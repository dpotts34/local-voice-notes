# Fill in your service URLs and model below.
# Missing required values stop startup and name the setting.
VOICE_STATE_DIR="$HOME/.local/state/voice-note-intake"
VOICE_ARCHIVE_DIR="$HOME/.local/share/voice-note-intake/archive"
VOICE_VAULT_DIR="$HOME/Documents/Obsidian"
VOICE_INBOX="Voice Inbox"
VOICE_BIND_HOST=127.0.0.1
VOICE_BIND_PORT=8791
VOICE_ASR_URL=
VOICE_LLM_URL=
VOICE_LLM_MODEL=
VOICE_NTFY_URL=
VOICE_MAX_UPLOAD_BYTES=52428800
VOICE_HTTP_TIMEOUT=30
VOICE_MAX_RETRIES=3
VOICE_REQUIRE_NFS_MOUNT=false
VOICE_ARCHIVE_MAX_BYTES=5368709120
# Git upload is off. Choose a dedicated note checkout and remote before enabling it.
VOICE_VAULT_SYNC=false
# VOICE_VAULT_REPO_DIR=/absolute/canonical/path/to/vault-checkout
# VOICE_VAULT_REMOTE=https://git.example.invalid/you/vault.git
# VOICE_VAULT_BRANCH=main
# VOICE_VAULT_GIT_SSH_KEY=/absolute/canonical/path/to/your-key
# Backup model is optional. Set both URL and model, or neither.
# VOICE_LLM_FALLBACK_URL=
# VOICE_LLM_FALLBACK_MODEL=
